<?xml version="1.0" encoding="utf-8"?>
<!-- Kit de nuevo ingreso · cabeceras de seguridad para IIS. La política de guiones va dentro de index.html. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />

    <!-- Redirección HTTP a HTTPS:
         No se incluye regla <rewrite> en este archivo porque requiere el módulo
         opcional IIS URL Rewrite; si dicho módulo no está instalado en el servidor,
         IIS responde con Error 500 en todo el sitio. La redirección a HTTPS debe
         configurarse a nivel de servidor o sitio en IIS. -->

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Cross-Origin-Resource-Policy" value="same-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <!-- Carpetas y archivos internos: no se sirven aunque se hayan subido por error. -->
        <hiddenSegments>
          <add segment=".agentes" />
          <add segment=".claude" />
          <add segment=".git" />
          <add segment=".gitignore" />
          <add segment=".htaccess" />
          <add segment="herramientas" />
          <add segment="dossier" />
          <add segment="paginas" />
          <add segment="desktop.ini" />
          <add segment="_headers" />
          <add segment="LEEME.txt" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- Control de caché: index.html se revalida siempre; fuentes y gráficos por 24 horas (sin immutable). -->
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="Base de datos/fuentes">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="public, max-age=86400" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="Base de datos/graficos">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="public, max-age=86400" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="Base de datos/folletos-pdf">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="Base de datos/presentaciones-pdf">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>


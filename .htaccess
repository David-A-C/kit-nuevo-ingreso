# Kit de nuevo ingreso · cabeceras de seguridad para Apache (el servidor del portal de la UNED).
# La política de guiones va dentro de index.html; aquí va lo que una <meta> no puede hacer.

# Redirección HTTP a HTTPS (301).
# Si el servidor está detrás de un proxy que descifra HTTPS, comprueba también X-Forwarded-Proto para evitar bucles.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Evita listados sin depender de «Options», que algunos servidores no
  # permiten en .htaccess y convertiría todo el kit en un error 500.
  RewriteCond %{REQUEST_URI} /$
  RewriteRule . - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # Solo el mismo sitio puede enmarcar el kit (por si el portal lo incrusta); nadie más.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

  # Control de caché: index.html se revalida siempre; fuentes y gráficos por 24 horas (sin immutable).
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
  <If "%{REQUEST_URI} =~ m#/Base de datos/(fuentes|graficos)/#">
    Header set Cache-Control "public, max-age=86400"
  </If>
  <If "%{REQUEST_URI} =~ m#/Base de datos/(folletos-pdf|presentaciones-pdf)/#">
    Header set Cache-Control "no-cache"
  </If>
</IfModule>

# Bloquear cualquier segmento que comience por punto, salvo /.well-known/ (para renovación de certificados).
RedirectMatch 404 "(?i)/\.(?!well-known/)"

# Nada interno se sirve aunque se haya subido por error.
RedirectMatch 404 "(?i)/(desktop\.ini|LEEME\.txt|[^/]+\.md|web\.config|_headers)$"
RedirectMatch 404 "(?i)/Base de datos/(herramientas|dossier|paginas)(/|$)"

